          "id": 87,
          "script": "define var bool onFlg\ndefine var fractional TOut\ndefine var fractional COut\ndefine var fractional BOut\non_tick\n{\n\tif (out Key.value == 0.0)\n\t{\n\t\tin Light.is_illuminated = false\n\t\tin RPS.is_illuminated = false\n\t\tvar TOut = 0.0\n\t\tvar onFlg = false\n\t}\n\telse\n\t{\n\t\tin Light.is_illuminated = true\n\t\tin RPS.is_illuminated = true\n\t\tvar onFlg = true\n\t}\n\tin RPS.display_value = (out Engine.rps / 50.0) - 1.0\n\tif (var onFlg)\n\t{\n\t\tvar TOut = 0.1\n\t\tvar COut = 1.0\n\t\tvar BOut = 0.0\n\t\tif (out Key.value == 1.0)\n\t\t{\n\t\t\tvar TOut = 0.5\n\t\t}\n\t\telseif (out HB.is_on == true)\n\t\t{\n\t\t\tvar COut = 1.0\n\t\t\tvar BOut = 1.0\n\t\t}\n\t\telseif ((out WH.rps < -0.1) && (out Steering_Wheel.right_pedal > 0.0))\n\t\t{\n\t\t\tvar BOut = 0.1\n\t\t\tvar COut = 1.0\n\t\t}\n\t\telseif ((out WH.rps > 0.1) && (out Steering_Wheel.left_pedal > 0.0))\n\t\t{\n\t\t\tvar BOut = 0.1\n\t\t\tvar COut = 1.0\n\t\t}\n\t\telseif (out GB.is_reverse && (out Steering_Wheel.left_pedal > 0.0))\n\t\t{\n\t\t\tvar TOut = 0.3\n\t\t\tvar COut = 0.0\n\t\t}\n\t\telseif (out Steering_Wheel.right_pedal > 0.0)\n\t\t{\n\t\t\tvar TOut = 0.5\n\t\t\tvar COut = 0.0\n\t\t}\n\t}\n\tin TH.input = var TOut\n\tin Clutch.input = var COut\n\tin Break.input = var BOut\n\tin BP.display_value = var BOut\n\tin THM.display_value = (var TOut * 2.0) - 1.0\n\tif (out Engine.temperature > 60.0)\n\t{\n\t\tin FAN.input = 1.0\n\t}\n\telse\n\t{\n\t\tin FAN.input = 0.0\n\t}\n\tif (out GB.current_gear == -1)\n\t{\n\t\tin GPI.display_value = to_fractional (out GB.current_gear)\n\t\tin GPI.is_illuminated = true\n\t\tin GR.is_illuminated = true\n\t}\n\telse\n\t{\n\t\tin GPI.display_value = to_fractional (out GB.current_gear)\n\t\tin GPI.is_illuminated = true\n\t\tin GR.is_illuminated = false\n\t}\n}\n"
        }
